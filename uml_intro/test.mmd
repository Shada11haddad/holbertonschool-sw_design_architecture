---
title: Library
---
classDiagram
direction TB
    class Library {
	    +add_book(book)
	    +register_user(user)
	    +create_loan(user, book) Loan
    }

    class Book {
	    +String title
	    +String author
	    +Boolean state
	    +mark_as_unavailable()
	    +mark_as_available()
    }

    class User {
	    +String name
	    +String email
    }

    class Loan {
	    +Date start_date
	    +Date end_date
	    +close_loan()
    }

    class UntitledClass {
    }

	note for Loan "Creating a loan marks its book unavailable.
Closing a loan marks its book available."

    Library "1" o-- "*" Book : manages
    Library "1" o-- "*" User : registers
    Library "1" o-- "*" Loan : creates
    User "1" -- "*" Loan : borrows
    Loan "*" --> "1" Book : for
    Library -- UntitledClass
